# ==============================================================================
# AI PR Debugger - Environment Configuration
# Copy this file to .env and configure your preferred provider.
# ==============================================================================

# --- OPTION 1: Google Gemini (Free Tier from Google AI Studio) ---
# Just paste your Gemini API key:
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# --- OPTION 2: OpenAI ---
# OPENAI_API_KEY=sk-proj-...
# LLM_MODEL=gpt-4o-mini

# --- OPTION 3: Local Ollama (100% Free, Offline, No API Key Required) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# --- OPTION 4: Custom AI Gateway (MLflow / LiteLLM / Workshop) ---
# LLM_BASE_URL=http://127.0.0.1:5001/gateway/mlflow/v1
# LLM_API_KEY=your-gateway-key
# LLM_MODEL=workshop-gemini

# --- OPTION 5: Deterministic Mock Mode (For CI/CD or offline demos) ---
# MOCK_LLM=true

